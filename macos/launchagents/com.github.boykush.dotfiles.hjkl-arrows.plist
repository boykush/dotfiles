<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Control + hjkl を矢印キーとして送る macos/bin/hjkl-arrows.swift を常駐させる。
  権限（アクセシビリティ）はバイナリ単位で付くため、swift で毎回解釈せず
  ~/.local/bin にビルドして使い、ソースが変わったときだけビルドし直す。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.boykush.dotfiles.hjkl-arrows</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>src="$HOME/dotfiles/macos/bin/hjkl-arrows.swift"; bin="$HOME/.local/bin/hjkl-arrows"; if [[ ! -x $bin || $src -nt $bin ]]; then mkdir -p "${bin:h}" &amp;&amp; /usr/bin/swiftc -O -o "$bin" "$src" || exit 1; fi; exec "$bin"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.github.boykush.dotfiles.hjkl-arrows.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.github.boykush.dotfiles.hjkl-arrows.log</string>
</dict>
</plist>
